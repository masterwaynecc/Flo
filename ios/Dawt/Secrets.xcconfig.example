// Copy to Secrets.xcconfig (gitignored) and fill in values from the Supabase dashboard.
// Project Settings → API → Project URL + anon / publishable key.
//
// Important: in .xcconfig files, // starts a comment. Do NOT write https://...
// Use this form instead so the double-slash survives:
//   DAWT_SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co

DAWT_SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
DAWT_SUPABASE_ANON_KEY = your_anon_or_publishable_key
